# OPBuying Trading Platform Environment Variables
# Copy this file to .env and fill in your actual values

# ── Telegram Configuration ────────────────────────────────────────────────
# Legacy names (read by legacy telegram engine / config bootstrap)
OPBUYING_BOT_TOKEN=your_telegram_bot_token_here
OPBUYING_CHAT_ID=your_telegram_chat_id_here
# Current names (read by core/services/notification_service.py and
# core/ics_telegram_bridge.py) — prefer these
OPBUYING_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPBUYING_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Broker Credential Bridge (BROKER_CONFIG.<field>_env) ──────────────────
# Resolved by _resolve_broker_config_env() in core/config_loader.py and
# index_app/domains/config/loader.py: each OPBUYING_BROKER_* var fills the
# matching BROKER_CONFIG field ONLY while the plain config value is empty
# (explicit values always win). Declared in config.json / config.template.json.
OPBUYING_BROKER_API_KEY=your_kite_api_key_here
OPBUYING_BROKER_ACCESS_TOKEN=your_kite_access_token_here
OPBUYING_BROKER_USER_ID=your_kite_user_id_here
OPBUYING_BROKER_PASSWORD=your_kite_password_here
OPBUYING_BROKER_TOTP_KEY=your_kite_totp_key_here
OPBUYING_BROKER_REFRESH_TOKEN=your_kite_refresh_token_here
OPBUYING_BROKER_CLIENT_ID=your_kite_client_id_here
OPBUYING_BROKER_SECRET=your_kite_secret_here

# ── Config Loading ─────────────────────────────────────────────────────────
# Path to the JSON config (default: json/config.json)
# OPBUYING_INDEX_CONFIG=json/config.dev.json
# Strict schema enforcement on load (default true; set 0/1/true/false)
# OPBUYING_CONFIG_STRICT_SCHEMA_ENFORCEMENT=1

# ── Environment & Execution ───────────────────────────────────────────────
# Deployment environment: DEV/QA/PAPER/SHADOW/STAGING/PRODUCTION
# (read by core/environment.py)
# OPBUYING_ENVIRONMENT=PAPER
# Broker driver override (GENERIC/KITE/ANGEL/CUSTOM; used by scripts/rollback.py)
# OPBUYING_BROKER_DRIVER=KITE

# ── Security / Secrets ─────────────────────────────────────────────────────
# Master key for the secrets vault (core/secrets_vault.py)
# OPBUYING_VAULT_KEY=change_me_to_a_strong_master_key
# Encryption key for secure credential storage
# (infrastructure/security/credential_storage.py)
# OPBUYING_SECURE_CONFIG_KEY=change_me
# Control-plane auth token (core/control_plane/server.py)
# OPBUYING_ADMIN_TOKEN=change_me
# Bootstrap admin password for auth handler (core/auth/handler/handler.py)
# OPBUYING_DEFAULT_ADMIN_PASSWORD=change_me
# Emergency master password-reset key for the /forgot-password page's
# "Emergency Reset" tab (core/auth/handler/handler.py::emergency_master_reset_password).
# Unset = feature disabled (fail-closed). Never commit a real value here.
# OPBUYING_EMERGENCY_MASTER_RECOVERY_KEY=change_me_to_a_long_random_secret

# ── Email Notifications (core/notification_service.py) ────────────────────
# OPBUYING_EMAIL_ENABLED=0
# OPBUYING_EMAIL_SMTP=smtp.example.com
# OPBUYING_EMAIL_PORT=587
# OPBUYING_EMAIL_USER=you@example.com
# OPBUYING_EMAIL_PASS=your_smtp_password
# OPBUYING_EMAIL_TO=recipient@example.com

# ── TLS (dashboard / API) ──────────────────────────────────────────────────
# OPBUYING_TLS_ENABLED=0
# OPBUYING_TLS_CERT=path/to/cert.pem
# OPBUYING_TLS_KEY=path/to/key.pem
# OPBUYING_TLS_CA_CERT=path/to/ca.pem

# ── Optional: Override other config values ────────────────────────────────
# Any OPBUYING_<KEY> matching an existing config key is applied at first load
# (case-insensitive, coerced to the existing value's type). Unknown keys are
# ignored — declare a default in index_config.defaults.json first.
# OPBUYING_BASE_CAPITAL=10000
# OPBUYING_EXECUTION_MODE=AUTO
