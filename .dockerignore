# ─────────────────────────────────────────────────────────────────────────────
# .dockerignore — OPB Bot v2.57.0
# Excludes files that should NOT be copied into the Docker build context.
# ─────────────────────────────────────────────────────────────────────────────

# Git
.git/
.gitignore
.gitattributes

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
.Python

# Virtual environments
venv/
.venv/
env/
.env/

# Secrets and local config (must be supplied via environment variables)
.env
*.env
json/config.local.json
json/config.dev.json
json/config.paper.json
json/config.starter.json
json/config.lowcap.json
json/config.live-validation.json
secrets/

# Credentials and API tokens (never bake into image)
*.pem
*.key
*.crt
*.p12

# Runtime data (mounted as Docker volumes)
db/
json/trader_state.json
json/incidents.json
json/audit_trail.jsonl
json/config_audit.jsonl
json/continuous_intelligence_history.jsonl
models/
reports/
logs/

# Test artefacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Documentation and notebooks
docs/
*.ipynb
*.md

# CI
.github/

# Temporary files
tmp/
temp/
STOP_TRADING
